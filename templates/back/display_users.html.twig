{% extends 'back/base.html.twig' %}

{% block content %}

    <br>
    <h1 align="center">Liste des produits</h1>
    <br>

    <div class="app-content content">
        <div class="content-wrapper">

            <div class="content-body"><!-- Basic Tables start -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <a class="heading-elements-toggle"><i class="fa fa-ellipsis-v font-medium-3"></i></a>
                                <div class="heading-elements">
                                    <ul class="list-inline mb-0">
                                        <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                                        <li><a data-action="reload"><i class="ft-rotate-cw"></i></a></li>
                                        <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                                        <li><a data-action="close"><i class="ft-x"></i></a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="card-content collapse show">

                                <div class="table-responsive">
                                    <br>
                                    <br>
                                    <div class="col-11 mb-2">
                                        {% if  users %}
                                            <table border="1" cellpadding="50" align="center" class="table">
                                                <thead class="bg-primary white">
                                                <tr>
                                                    <th>E-Mail</th>
                                                    <th>Nom</th>
                                                    <th>Prenom</th>
                                                    <th>Ville</th>
                                                    <th>Adresse</th>
                                                    <th>Sexe</th>
                                                    <th>Date Naissance</th>
                                                    <th>Numéro de téléphone</th>
                                                    <th>Roles</th>
                                                    <th colspan="4" style="text-align: center">Gestion</th>
                                                </tr>
                                                </thead>
                                                <tr {% for u in users %}>
                                                    <td>{{ u.email }}</td>
                                                    <td>{{ u.nom }}</td>
                                                    <td>{{ u.prenom }}</td>
                                                    <td>{{ u.ville }}</td>
                                                    <td>{{ u.adresse }}</td>
                                                    <td>{{ u.sexe }}</td>
                                                    <td>{{ u.dateNaiss|date('d-m-Y') }}</td>
                                                    <td>{{ u.tel }}</td>
                                                    <td>
                                                        {% for role in u.roles %}
                                                            {{ role }}
                                                        {% endfor %}
                                                    </td>
                                                    <td><div class="btn-group"> <a href="{{ path('admin_DeleteClient', {'id':u.id}) }}" ><button type="button" class="btn btn-danger">Supprimer</button></a></div></td>

                                                </tr {% endfor %}>
                                            </table>
                                        {% else %}
                                            <div style="text-align: center">Aucun utilisateur trouvé</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}